/** Создание карточек Ozon и синхронизация результата со складом. */
function createOzonCards_(sh,h,targets,retry){let processed=0,success=0,errors=0;
  targets.forEach(t=>{const r=sh.getRange(t.row,1,1,sh.getLastColumn()).getValues()[0],offer=asText_(r[h['Артикул продавца']-1]);if(asText_(r[h['Ozon Product ID']-1]))return;
    // Сначала проверяем ранее сохранённое асинхронное задание.
    const task=ozCardTaskGet_(offer);if(task){const st=ozonCheckImportTask_(task,offer);if(st.done){if(st.ok){finalizeOzonCard_(sh,t.row,h,offer,st.productId);success++;ozCardTaskDelete_(offer);return;}ozCardTaskDelete_(offer);setCardMarketResult_(sh,t.row,h,'Ozon','ОШИБКА',st.error);if(!retry){errors++;return;}}else{setCardMarketResult_(sh,t.row,h,'Ozon','ОЖИДАЕТ ОБРАБОТКИ','');return;}}
    const existing=ozonFindProductByOffer_(offer);if(existing&&existing.id){finalizeOzonCard_(sh,t.row,h,offer,existing.id,existing.sku);success++;return;}
    if(asText_(r[h['Проверка Ozon']-1])!=='ГОТОВО'){errors++;return;}
    try{const ctx=cardRowContext_(r,h),item=buildOzonImportItem_(sh,t.row,r,h,ctx);const resp=ozonRequest_('/v3/product/import',{items:[item]},'Создание карточки Ozon').json||{},taskId=Number(resp.result&&resp.result.task_id||resp.task_id);processed++;if(!taskId)throw new Error('Ozon не вернул task_id.');ozCardTaskSet_(offer,taskId);setCardMarketResult_(sh,t.row,h,'Ozon','ОТПРАВЛЕНО — ОЖИДАЕТ ОБРАБОТКИ','');
      let final=null;for(let i=0;i<4;i++){Utilities.sleep(1000);final=ozonCheckImportTask_(taskId,offer);if(final.done)break;}if(final&&final.done){if(final.ok){finalizeOzonCard_(sh,t.row,h,offer,final.productId);success++;ozCardTaskDelete_(offer);}else{errors++;ozCardTaskDelete_(offer);setCardMarketResult_(sh,t.row,h,'Ozon','ОШИБКА',final.error);}}
    }catch(e){errors++;setCardMarketResult_(sh,t.row,h,'Ozon','ОШИБКА',e.message);}
  });return {processed:processed,success:success,errors:errors};
}
function buildOzonImportItem_(sh,row,r,h,ctx){if(!ctx.oz)throw new Error('Не выбран тип товара Ozon');const attrs=[],brand=asText_(r[h['Бренд']-1])||asText_(getSetting_('Бренд по умолчанию','')),required=ozonRequiredAttributes_(ctx.oz.categoryId,ctx.oz.typeId);
  // Тип передаём и отдельным type_id, и атрибутом 8229 для совместимости текущей схемы.
  attrs.push({id:8229,complex_id:0,values:[{dictionary_value_id:Number(ctx.oz.typeId),value:asText_(ctx.oz.name).split(' — ')[0]}]});
  required.forEach(a=>{if(a.id===8229)return;let value='';if(a.id===85)value=brand;else if(a.id===4191)value=asText_(r[h['Описание']-1]);else{const x=cardDynamicAttributesForRow_(sh,row,ctx,'Ozon').find(v=>Number(v.meta.id)===a.id);value=x?x.value:'';}
    const vals=ozonAttributeValues_(ctx.oz,a,value);attrs.push({id:a.id,complex_id:Number(a.complexId)||0,values:vals});});
  const urls=cardImageUrls_(sh,row,h),vat=asText_(getSetting_('НДС Ozon по умолчанию','0'))||'0';
  return {offer_id:asText_(r[h['Артикул продавца']-1]),name:asText_(r[h['Название']-1]),barcode:asText_(r[h['Штрихкод']-1]),description_category_id:Number(ctx.oz.categoryId),type_id:Number(ctx.oz.typeId),price:String(Math.round(toNumber_(r[h['Цена']-1]))),currency_code:'RUB',vat:vat,depth:Math.round(toNumber_(r[h['Длина упаковки, см']-1])*10),width:Math.round(toNumber_(r[h['Ширина упаковки, см']-1])*10),height:Math.round(toNumber_(r[h['Высота упаковки, см']-1])*10),dimension_unit:'mm',weight:Math.round(toNumber_(r[h['Вес с упаковкой, г']-1])),weight_unit:'g',primary_image:urls[0],images:urls,attributes:attrs,complex_attributes:[]};
}
function ozonAttributeValues_(ctx,a,value){const parts=(a.maxCount>1?asText_(value).split(/[,;\n]+/):[asText_(value)]).map(x=>x.trim()).filter(Boolean);if(!parts.length)throw new Error('Не заполнено Ozon | '+a.name);return parts.map(v=>a.dictionaryId?ozonResolveDictionaryValue_(ctx.categoryId,ctx.typeId,{id:a.id,name:a.name},v):{value:v});}
function ozonCheckImportTask_(taskId,offer){const r=ozonRequest_('/v1/product/import/info',{task_id:Number(taskId)},'Статус создания Ozon').json||{},items=(r.result&&r.result.items)||[];const x=items.find(z=>normKey_(z.offer_id)===normKey_(offer))||items[0];if(!x)return {done:false};const status=asText_(x.status).toLowerCase();if(status==='imported'&&Number(x.product_id)>0)return {done:true,ok:true,productId:Number(x.product_id)};if(status==='failed'){const errs=(x.errors||[]).map(e=>asText_(e.message||e.description||e.code)).filter(Boolean).join('; ');return {done:true,ok:false,error:errs||'Ozon отклонил карточку.'};}return {done:false};}
function ozonFindProductByOffer_(offer){if(!offer)return null;try{const r=ozonRequest_('/v3/product/list',{filter:{offer_id:[offer],visibility:'ALL'},limit:100},'Поиск карточки Ozon').json||{},items=(r.result&&r.result.items)||[];if(!items.length)return null;const x=items[0];return {id:Number(x.product_id||x.id)||0,sku:asText_(x.sku)};}catch(_){return null;}}
function finalizeOzonCard_(sh,row,h,offer,productId,sku){const found=ozonFindProductByOffer_(offer)||{};const id=Number(productId||found.id)||0;if(!id)throw new Error('Ozon подтвердил импорт, но product_id пока не получен. Повторите проверку позже.');sh.getRange(row,h['Ozon Product ID']).setValue(id);if(h['Ozon SKU']&&asText_(found.sku||sku))sh.getRange(row,h['Ozon SKU']).setValue(asText_(found.sku||sku));setCardMarketResult_(sh,row,h,'Ozon','СОЗДАНО','');upsertNewCardStock_(sh,row,h,{ozon:{id:String(id),offer:offer,sku:asText_(found.sku||sku)}});}
function ozCardTaskKey_(offer){return CARD_OZ_TASK_PREFIX+Utilities.base64EncodeWebSafe(asText_(offer)).replace(/=+$/,'').substring(0,120);}function ozCardTaskGet_(offer){return Number(PropertiesService.getScriptProperties().getProperty(ozCardTaskKey_(offer)))||0;}function ozCardTaskSet_(offer,id){PropertiesService.getScriptProperties().setProperty(ozCardTaskKey_(offer),String(id));}function ozCardTaskDelete_(offer){PropertiesService.getScriptProperties().deleteProperty(ozCardTaskKey_(offer));}

function setCardMarketResult_(sh,row,h,market,status,error){const statusCol=h['Статус '+market],errCol=h['Ошибка '+market];if(statusCol)sh.getRange(row,statusCol).setValue(status);if(errCol)sh.getRange(row,errCol).setValue(error||'');}
function finalizeCardDateAndStock_(sh,row,h){const wb=asText_(sh.getRange(row,h['WB NMID']).getValue()),oz=asText_(sh.getRange(row,h['Ozon Product ID']).getValue());if(wb||oz){if(!sh.getRange(row,h['Дата создания']).getValue())sh.getRange(row,h['Дата создания']).setValue(now_());upsertNewCardStock_(sh,row,h,{});}}

function upsertNewCardStock_(cards,row,h,parts){
  const vals=cards.getRange(row,1,1,cards.getLastColumn()).getValues()[0],iid=asText_(vals[h['Внутренний ID']-1])||uuid_(),article=asText_(vals[h['Артикул продавца']-1]),barcode=asText_(vals[h['Штрихкод']-1]),name=asText_(vals[h['Название']-1]),cat=asText_(vals[h['Наша категория']-1]);
  const wbId=asText_(cards.getRange(row,h['WB NMID']).getValue())||(parts.wb&&asText_(parts.wb.id))||'',ozId=asText_(cards.getRange(row,h['Ozon Product ID']).getValue())||(parts.ozon&&asText_(parts.ozon.id))||'',ozSku=asText_(cards.getRange(row,h['Ozon SKU']).getValue())||(parts.ozon&&asText_(parts.ozon.sku))||'';
  cards.getRange(row,h['Внутренний ID']).setValue(iid);
  const st=sheet_(APP.SHEETS.STOCK),sh=findHeaderMap_(st);let target=0;if(st.getLastRow()>1)st.getRange(2,1,st.getLastRow()-1,st.getLastColumn()).getValues().some((r,i)=>{if(asText_(r[sh['Внутренний ID']-1])===iid||normKey_(r[sh['Артикул основной']-1])===normKey_(article)){target=i+2;return true;}return false;});if(!target)target=st.getLastRow()+1;
  const prev=target<=st.getLastRow()?st.getRange(target,1,1,st.getLastColumn()).getValues()[0]:Array(st.getLastColumn()).fill('');const set=(key,val,onlyBlank)=>{const c=sh[key];if(!c)return;if(onlyBlank&&asText_(prev[c-1]))return;prev[c-1]=val;};
  set('Внутренний ID',iid);set('Наименование',name);set('Категория',cat);set('Артикул основной',article);set('Штрихкод',barcode);if(target>st.getLastRow())set('Фактический остаток',0);set('WB подключён',!!wbId);set('WB NMID',wbId);set('WB артикул',wbId?article:'');set('WB SKU / barcode',wbId?barcode:'');set('Ozon подключён',!!ozId);set('Ozon Product ID',ozId);set('Ozon Offer ID',ozId?article:'');set('Ozon SKU',ozSku);set('Статус сопоставления',wbId&&ozId?'Сопоставлен':wbId?'Только WB':ozId?'Только Ozon':'');set('Источник названия',wbId?'WB':ozId?'Ozon':'');set('Последняя синхронизация',now_());
  if(parts.wb){set('WB Subject ID (служебно)',parts.wb.subjectId||'');const d=parts.wb.dimensions||{};set('WB Длина, см (служебно)',d.length||'');set('WB Ширина, см (служебно)',d.width||'');set('WB Высота, см (служебно)',d.height||'');set('WB chrtId (служебно)',parts.wb.chrtId||'');}
  st.getRange(target,1,1,st.getLastColumn()).setValues([prev]);upsertNewCardMatching_(iid,article,barcode,name,wbId,ozId,ozSku);return iid;
}
function upsertNewCardMatching_(iid,article,barcode,name,wbId,ozId,ozSku){const m=sheet_(APP.SHEETS.MATCHING),h=findHeaderMap_(m);let row=0;if(m.getLastRow()>1)m.getRange(2,1,m.getLastRow()-1,m.getLastColumn()).getValues().some((r,i)=>{if(asText_(r[h['Внутренний ID']-1])===iid){row=i+2;return true;}return false;});if(!row)row=m.getLastRow()+1;const vals=Array(m.getLastColumn()).fill(''),put=(k,v)=>{if(h[k])vals[h[k]-1]=v;};put('Внутренний ID',iid);put('WB NMID',wbId);put('WB артикул',wbId?article:'');put('WB наименование',wbId?name:'');put('WB штрихкод',wbId?barcode:'');put('Ozon Product ID',ozId);put('Ozon Offer ID',ozId?article:'');put('Ozon наименование',ozId?name:'');put('Ozon штрихкод',ozId?barcode:'');put('Найдено по',wbId&&ozId?'Создание карточки':'');put('Уверенность совпадения',wbId&&ozId?'Подтверждено':'');put('Статус',wbId&&ozId?'Сопоставлен':wbId?'Только WB':ozId?'Только Ozon':'');put('Подтверждено вручную',wbId&&ozId);m.getRange(row,1,1,m.getLastColumn()).setValues([vals]);}
